# Caddy reverse proxy for the split deployment - HTTP-ONLY ORIGIN.
#
# The origin holds NO certificate and is reached over plain HTTP on :80. TLS is
# terminated upstream: the CDN edge in front of io.iioooo.com and the Cloudflare
# edge (Flexible) in front of cf.iioooo.com. Do NOT turn a hostname into a bare
# site block: a bare block makes Caddy attempt automatic HTTPS (ACME) for a name
# that resolves to the edge, not to this host.
#
# Host-based routing matters: every edge preserves the original Host, so the
# combined site block below handles all of them.
#
# trusted_proxies MUST list the edges (plus loopback for the tunneled relay) so
# that, with trusted_proxies_strict, {client_ip} is the REAL client; otherwise
# CRITICAL_RATE_LIMIT aggregates every request into a single proxy IP and
# returns 429.
#
# flush_interval -1 disables response buffering so SSE streaming from the relay
# reaches clients immediately.

{
	servers {
		trusted_proxies static 127.0.0.1/32 ::1/128 8.137.125.24/32 154.201.84.0/24 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

http://io.iioooo.com, http://hk.iioooo.com, http://cf.iioooo.com {
	encode gzip

	# Cap the request body at the origin (15M uplink protection). base64 images
	# inflate ~1/3, so a 10MB body is ~7.5MB of raw image; anything larger is
	# rejected with 413 here, before any egress to the upstream provider.
	request_body {
		max_size 10MB
	}

	reverse_proxy frontend:80 {
		flush_interval -1
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-Proto https
	}
}
